<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SafeWorkTV - Simulador Maestro NOM-002</title>
<link href="https://fonts.googleapis.com/css2?family=Chivo+Mono:wght@400;700&family=Orbitron:wght@700;900&display=swap" rel="stylesheet">
<style>
    :root { --gold: #d4af37; --gold-dim: #997a1d; --bg: #050505; --critical: #ff4500; --success: #27ae60; }
    body { font-family: 'Chivo Mono', monospace; background: var(--bg); color: #fff; margin: 0; overflow: hidden; display: flex; justify-content: center; align-items: center; min-height: 100vh; }

    /* CARÁTULA SafeWorkTV */
    #welcome-screen { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: radial-gradient(circle at center, #222 0%, #000 100%); z-index: 1000; display: flex; justify-content: center; align-items: center; transition: transform 0.8s cubic-bezier(0.85, 0, 0.15, 1); }
    .bg-fire-fx { position: absolute; width: 100%; height: 100%; overflow: hidden; opacity: 0.3; }
    .particle { position: absolute; bottom: -10%; background: var(--critical); border-radius: 50%; filter: blur(5px); animation: rise 4s infinite ease-in; }
    @keyframes rise { 0% { transform: translateY(0) scale(1); opacity: 1; } 100% { transform: translateY(-1000px) scale(0.5); opacity: 0; } }
    .cover-art { width: 90%; max-width: 800px; border: 2px solid var(--gold-dim); border-radius: 20px; background: rgba(20, 20, 20, 0.9); backdrop-filter: blur(10px); text-align: center; padding: 70px 40px; box-shadow: 0 0 80px rgba(0,0,0,1); position: relative; border-top: 8px solid var(--gold); }
    .logo-main { font-family: 'Orbitron'; font-weight: 900; font-size: 4.5rem; color: var(--gold); margin: 0; text-shadow: 0 0 20px rgba(212,175,55,0.5); }
    .nom-tag { background: var(--gold); color: black; font-weight: 900; font-family: 'Orbitron'; padding: 10px 25px; margin: 20px 0; display: inline-block; font-size: 1.3rem; transform: skew(-10deg); }
    .sub-brand { font-family: 'Orbitron'; color: white; letter-spacing: 6px; font-size: 0.8rem; margin-bottom: 40px; opacity: 0.7; }
    .btn-start-gold { background: linear-gradient(145deg, var(--gold), var(--gold-dim)); color: black; border: none; padding: 25px 60px; font-family: 'Orbitron'; font-weight: 900; font-size: 1.2rem; cursor: pointer; border-radius: 5px; transition: 0.3s; text-transform: uppercase; box-shadow: 0 10px 20px rgba(0,0,0,0.5); }
    .btn-start-gold:hover { transform: scale(1.05); box-shadow: 0 0 30px var(--gold); }

    /* INTERFAZ DE JUEGO */
    #main-app { width: 98%; max-width: 1000px; border: 3px solid var(--gold-dim); border-radius: 12px; background: #000; display: none; opacity: 0; transition: 0.5s; }
    .header { background: #111; padding: 20px; border-bottom: 3px solid var(--gold); display: flex; justify-content: space-between; align-items: center; }
    .brand-full { font-family: 'Orbitron'; color: var(--gold); font-size: 1.7rem; font-weight: 900; text-shadow: 0 0 10px var(--gold-dim); letter-spacing: 1px; }
    .hud { display: flex; gap: 15px; }
    .stat-card.big { border: 2px solid #333; padding: 10px 20px; text-align: center; background: #000; border-radius: 8px; font-size: 0.85rem; min-width: 100px; }
    .stat-card.big b { font-size: 1.8rem; font-family: 'Orbitron'; }
    #view-port { height: 380px; display: flex; flex-direction: column; justify-content: center; align-items: center; position: relative; overflow: hidden; background: radial-gradient(circle, #151515 0%, #000 100%); }
    .text-panel { background: rgba(0,0,0,0.9); padding: 20px; border-radius: 12px; border: 1px solid var(--gold); width: 80%; z-index: 10; }
    .hazard-sprite { font-size: 9rem; filter: drop-shadow(0 0 25px var(--gold)); z-index: 5; margin-top: 15px; }
    .fire-anim { font-size: 4rem; position: absolute; bottom: -10px; z-index: 1; opacity: 0.4; animation: flicker 0.1s infinite alternate; }
    .controls { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 12px; padding: 25px; background: #0a0a0a; }
    .btn-extintor { background: linear-gradient(145deg, #444, #111); color: #fff; border: 1px solid var(--gold-dim); padding: 20px; border-radius: 6px; cursor: pointer; font-family: 'Orbitron'; font-weight: bold; font-size: 0.9rem; transition: 0.2s; }
    .btn-extintor:hover { background: var(--gold); color: #000; transform: scale(1.05); }

    /* OVERLAY RESULTADOS */
    .overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.98); display: none; align-items: center; justify-content: center; z-index: 6000; }
    .feedback-card { background: #fff; color: #000; width: 90%; max-width: 550px; padding: 40px; border-radius: 20px; text-align: center; border: 10px solid var(--gold); }
    .btn-next { background: var(--success); color: #fff; padding: 20px; width: 100%; border: none; font-weight: bold; cursor: pointer; border-radius: 10px; font-family: 'Orbitron'; font-size: 1.2rem; }
    
    .dancer { font-size: 5rem; display: inline-block; animation: dance 0.6s infinite alternate; margin: 15px 0; }
    @keyframes dance { from { transform: rotate(-15deg) translateY(0); } to { transform: rotate(15deg) translateY(-20px); } }
    @keyframes flicker { from { transform: scale(1); } to { transform: scale(1.1); } }
</style>
</head>
<body>

<div id="welcome-screen">
    <div class="bg-fire-fx" id="fire-particles"></div>
    <div class="cover-art">
        <h1 class="logo-main">SafeWorkTV</h1>
        <div class="nom-tag">SIMULADOR NOM-002</div>
        <p class="sub-brand">SEGURIDAD INDUSTRIAL</p>
        <p style="color:white; margin-bottom: 40px; font-weight: bold; letter-spacing: 2px;">CALIFICACIÓN MÍNIMA: 85% | SONIDO DINÁMICO</p>
        <button class="btn-start-gold" onclick="initExperience()">INICIAR EVALUACIÓN</button>
    </div>
</div>

<div id="main-app">
    <div class="header">
        <div class="brand-full">SafeWorkTV</div>
        <div class="hud">
            <div class="stat-card big">TIEMPO<br><b id="timer">10</b></div>
            <div class="stat-card big">OK<br><b id="count-ok" style="color:var(--success)">0</b></div>
            <div class="stat-card big">ERR<br><b id="count-err" style="color:var(--critical)">0</b></div>
            <div class="stat-card big">FASE<br><b id="fase">0/20</b></div>
        </div>
    </div>

    <div id="view-port">
        <div class="text-panel">
            <h2 id="target-title">SISTEMA INICIADO</h2>
            <p id="target-desc">Analice el objeto y actúe</p>
        </div>
        <div id="hazard-icon" class="hazard-sprite">🏭</div>
        <div class="fire-anim">🔥🔥🔥🔥🔥</div>
    </div>

    <div class="controls" id="action-panel"></div>
</div>

<div id="overlay-result" class="overlay">
    <div class="feedback-card">
        <h2 id="fb-title"></h2>
        <div id="fb-content"></div>
        <button id="btn-flow" class="btn-next" onclick="flowControl()"></button>
    </div>
</div>

<audio id="sfx-alarm" loop><source src="https://www.soundjay.com/buttons/sounds/beep-07.mp3" type="audio/mpeg"></audio>
<audio id="sfx-success"><source src="https://www.soundjay.com/sci-fi/sounds/futuristic-door-open-01.mp3" type="audio/mpeg"></audio>
<audio id="sfx-error"><source src="https://www.soundjay.com/buttons/sounds/button-10.mp3" type="audio/mpeg"></audio>

<script>
const container = document.getElementById('fire-particles');
for (let i = 0; i < 30; i++) {
    const p = document.createElement('div');
    p.className = 'particle';
    const size = Math.random() * 12 + 4 + 'px';
    p.style.width = size; p.style.height = size;
    p.style.left = Math.random() * 100 + '%';
    p.style.animationDelay = Math.random() * 4 + 's';
    container.appendChild(p);
}

const masterDB = [
    { c: "A", s: "🪑", t: "OFICINAS", d: "Sillas de madera y archiveros de melamina ardiendo tras un descuido.", tip: "Los fuegos en madera requieren agua para enfriar el material profundo." },
    { c: "A", s: "🪵", t: "ALMACÉN", d: "Pilas de tarimas de madera soltando chispas y humo gris.", tip: "Las tarimas requieren un agente que penetre las brasas; el agua elimina el calor residual." },
    { c: "B", s: "🎨", t: "TALLER ACABADOS", d: "Cubetas de 19 litros con pintura base aceite soltando flamas sobre el banco.", tip: "Nunca uses agua en pinturas; el combustible flotará y el incendio se extenderá." },
    { c: "B", s: "⛽", t: "SURTIDOR", d: "Gasolina derramada en el suelo de la estación de servicio incendiada.", tip: "La gasolina requiere sofocación inmediata con PQS para cortar el paso del oxígeno." },
    { c: "C", s: "💻", t: "SITE", d: "Computadoras y racks de servidores soltando humo negro y olor a plástico.", tip: "El CO2 apaga el fuego en electrónica sin dejar residuos que corroan los circuitos." },
    { c: "C", s: "📟", t: "CONTROL", d: "Tablero eléctrico principal soltando chispas y un arco eléctrico activo.", tip: "En equipos con energía, el agente debe ser no conductor. El CO2 garantiza tu seguridad." },
    { c: "D", s: "🔩", t: "MAQUINADO", d: "Virutas de Magnesio encendidas con luz blanca intensa en la charola.", tip: "Las virutas de metal explotan con agua. Solo usa agentes especiales Clase D." },
    { c: "K", s: "🍳", t: "COMEDOR", d: "Aceite vegetal incendiado dentro de una freidora industrial.", tip: "El aceite de cocina requiere Clase K para crear una capa de jabón que sella el calor." }
];

const agentMap = { A: "AGUA", B: "PQS", C: "CO2", D: "METAL", K: "K" };
const finalDB = [];
masterDB.forEach(item => finalDB.push(item));
for(let i=0; i<72; i++){
    let base = masterDB[i % masterDB.length];
    finalDB.push({...base, t: base.t + " SECTOR " + (i+10), d: "Fuego en " + base.t.toLowerCase() + " involucrando " + base.d.split(" ardiendo")[0] + ".", ok: agentMap[base.c]});
}

let shuffleData = [], current = 0, aciertos = 0, errores = 0, seconds = 10, timerRef;
const alarm = document.getElementById('sfx-alarm');
const soundOk = document.getElementById('sfx-success');
const soundErr = document.getElementById('sfx-error');

function initExperience() {
    document.getElementById('welcome-screen').style.transform = 'translateY(-100%)';
    document.getElementById('main-app').style.display = 'block';
    setTimeout(() => document.getElementById('main-app').style.opacity = '1', 100);
    startEval();
}

function startEval() {
    let pool = [...finalDB];
    for (let i = pool.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [pool[i], pool[j]] = [pool[j], pool[i]];
    }
    shuffleData = pool.slice(0, 20).map(item => ({...item, ok: agentMap[item.c] || item.ok}));
    current = 0; aciertos = 0; errores = 0;
    loadScenario();
}

function loadScenario() {
    if(current >= 20) { showFinalReport(); return; }
    const data = shuffleData[current];
    document.getElementById('overlay-result').style.display = 'none';
    document.getElementById('count-ok').innerText = aciertos;
    document.getElementById('count-err').innerText = errores;
    document.getElementById('fase').innerText = `${current + 1}/20`;
    document.getElementById('hazard-icon').innerText = data.s;
    document.getElementById('target-title').innerText = data.t;
    document.getElementById('target-desc').innerText = data.d;
    
    document.getElementById('action-panel').innerHTML = `
        <button class="btn-extintor" onclick="validate('AGUA')">AGUA (A)</button>
        <button class="btn-extintor" onclick="validate('PQS')">PQS (ABC)</button>
        <button class="btn-extintor" onclick="validate('CO2')">CO2 (BC)</button>
        <button class="btn-extintor" onclick="validate('METAL')">METAL (D)</button>
        <button class="btn-extintor" onclick="validate('K')">CLASE K</button>
    `;
    
    seconds = 10;
    document.getElementById('timer').innerText = seconds;
    alarm.play();
    clearInterval(timerRef);
    timerRef = setInterval(() => {
        seconds--;
        document.getElementById('timer').innerText = seconds;
        if(seconds <= 0) validate('TIMEOUT');
    }, 1000);
}

function validate(pick) {
    clearInterval(timerRef);
    alarm.pause();
    alarm.currentTime = 0; // Reinicia alarma
    
    const q = shuffleData[current];
    const win = (pick === q.ok);
    
    if(win) {
        aciertos++;
        soundOk.play(); // Sonido de éxito
    } else {
        errores++;
        soundErr.play(); // Sonido de error
    }
    
    const modal = document.getElementById('overlay-result');
    document.getElementById('fb-title').innerText = win ? "✔ CORRECTO" : "✘ FALLO";
    document.getElementById('fb-title').style.color = win ? "#27ae60" : "#ff4500";
    
    const prefijo = win ? "" : "<b>Recuerda:</b> ";
    const subTexto = win ? "¡Excelente! Has identificado el objeto y su agente correcto." : (pick === 'TIMEOUT' ? "¡Tiempo agotado!" : "Ese agente no es apto para extinguir este objeto.");
    
    document.getElementById('fb-content').innerHTML = `
        <h2 style="font-size:2rem">${win ? "RIESGO CONTROLADO" : "BRIGADA FALLIDA"}</h2>
        <p style="margin-bottom:15px; font-weight: bold;">${subTexto}</p>
        <div style="background:#eef6ff; padding:15px; border-radius:10px; font-style:italic; border-left: 5px solid #2980b9; color:#2c3e50; text-align:left;">
            ${prefijo}${q.tip}
        </div>
    `;
    
    document.getElementById('btn-flow').innerText = "CONTINUAR";
    modal.style.display = 'flex';
}

function showFinalReport() {
    const calif = (aciertos / 20) * 100;
    const aprobado = calif >= 85;
    document.getElementById('fb-title').innerText = "REPORTE FINAL";
    document.getElementById('fb-title').style.color = "#000";
    
    let content = `
        <div style="font-size:4rem; font-weight:900; margin:10px 0;">${calif}%</div>
        <p style="font-size:1.5rem; font-weight:bold; color:${aprobado ? 'green' : 'red'}">
            ${aprobado ? 'PERSONAL APTO PARA BRIGADA' : 'NO APTO - SIGUE PRACTICANDO'}
        </p>
    `;
    
    if(aprobado) {
        content += `<div class="dancer">👨‍🚒🧯💨</div><p>¡Eres un experto brigadista de SafeWorkTV!</p>`;
    } else {
        content += `<p style="font-size:3rem;">📋⚠️</p><p>Analiza mejor la naturaleza del objeto antes de actuar.</p>`;
    }
    
    document.getElementById('fb-content').innerHTML = content;
    document.getElementById('btn-flow').innerText = "REINICIAR";
    document.getElementById('overlay-result').style.display = 'flex';
    current = 99;
}

function flowControl() {
    if(current === 99) {
        document.getElementById('overlay-result').style.display = 'none';
        document.getElementById('welcome-screen').style.transform = 'translateY(0)';
    } else {
        current++;
        loadScenario();
    }
}
</script>
</body>
</html>
